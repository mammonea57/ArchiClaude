# Cloud runtime files
tmp/
.vercel/

# Render outputs : 178MB of intermediate iter PNGs — too big for git.
# Only the iter #320 baseline is version-controlled (refs/baselines/).
# NOTE : we ignore the heavy files (PNG, JPG, EXR) NOT the whole directory,
# because git's `!` exception doesn't work if the parent directory itself
# is excluded. This way the .usda + .meta.json text files flow normally.
refs/renders/*.png
refs/renders/*.jpg
refs/renders/*.jpeg
refs/renders/*.exr
refs/renders/*.tiff
refs/renders/index.html
backups/


# Scheduled tasks lock
.claude/scheduled_tasks.lock

# Render-service training data + venv
apps/render-service/training/
apps/render-service/.venv/

# UE5 texture cache (downloaded from Polyhaven via download_polyhaven.py).
# Tens of GB of jpg/png. Reproducible by re-running the downloader.
apps/render-service/ue5/textures/textures_cache/

# Backend scripts that are project-specific
apps/backend/scripts/insert_bm_v5.py
