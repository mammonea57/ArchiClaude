# Render outputs : 178MB of intermediate iter PNGs — too big for git.
# Only the iter #320 baseline is version-controlled (refs/baselines/).
refs/renders/
backups/
# Exception : .usda scenes are USD ASCII (~MB text) and we need to ship
# them from Mac (Blender step) → MSI render station (UE5 step).
!refs/renders/*.usda


# Scheduled tasks lock
.claude/scheduled_tasks.lock

# Render-service training data + venv
apps/render-service/training/
apps/render-service/.venv/

# UE5 texture cache (downloaded from Polyhaven via download_polyhaven.py).
